{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and Run C++ (Git Bash)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "cd \"${fileDirname}\" && g++ \"${file}\" -o \"${fileBasenameNoExtension}.exe\" && ./\"${fileBasenameNoExtension}.exe\""
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}

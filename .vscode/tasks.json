{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C++ (g++)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-g",
        "${fileBasename}", // This becomes just "fixed-width-int.cpp"
        "-o",
        "${fileBasenameNoExtension}.exe" // This becomes just "fixed-width-int.exe"
      ],
      "options": {
        "cwd": "${fileDirname}" // <-- This is the most important line
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}